NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://trusttrade:replace-with-local-password@localhost:5432/trusttrade?schema=public
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=trusttrade_session
SESSION_TTL_DAYS=14
PRIVATE_STORAGE_DIR=./private-uploads
TRUSTTRADE_API_URL=http://localhost:4000

# Server-only Cloudinary credentials. Do not copy these into apps/web/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=
CLOUDINARY_VIDEO_UPLOAD_PRESET=

# Only set these temporarily when running the controlled admin:create CLI.
# Never use these values for public registration or commit real credentials.
# ADMIN_EMAIL=admin@example.com
# ADMIN_FULL_NAME=TrustTrade Administrator
# ADMIN_INITIAL_PASSWORD=replace-with-a-unique-12-character-minimum-password
